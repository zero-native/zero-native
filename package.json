{
  "name": "zero-native",
  "private": true,
  "type": "module",
  "bin": {
    "zn": "tools/zn.ts"
  },
  "workspaces": [
    "packages/*",
    "plugins/*",
    "compiler",
    "tools",
    "examples/*",
    "server"
  ],
  "scripts": {
    "sample:js": "bun run examples/sample/build.ts",
    "dev": "bun run tools/zn-dev.ts",
    "ota": "bun run tools/ota/cli.ts",
    "ota:phone": "bun run tools/ota/phone-matrix.ts",
    "updates": "bun run tools/updates/cli.ts",
    "updates:server": "bun run server/src/local.ts",
    "updates:phone": "bun run tools/updates/phone-suite.ts",
    "gen:registry": "bun run tools/gen-registry.ts",
    "gen:tag-props": "bun run tools/gen-tag-props.ts",
    "test": "bun test packages plugins compiler tools server && bun run test:types",
    "test:types": "tsc -p packages/core/test/tsconfig.types.json && tsc -p examples/sample",
    "ios:ota-test": "bun run tools/ios-ota-test.ts"
  },
  "devDependencies": {
    "fflate": "0.8.2",
    "hermes-compiler": "260318099.0.5",
    "typescript": "5.9.3"
  }
}
