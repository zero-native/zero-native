{
  "name": "zero-native",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "compiler",
    "examples/*"
  ],
  "scripts": {
    "sample:js": "bun run examples/sample/build.ts",
    "dev": "bun run tools/zn-dev.ts",
    "gen:registry": "bun run tools/gen-registry.ts",
    "test": "bun test packages compiler && bun run test:types",
    "test:types": "tsc -p packages/core/test/tsconfig.types.json"
  },
  "devDependencies": {
    "hermes-compiler": "250829098.0.17",
    "typescript": "5.9.3"
  }
}
