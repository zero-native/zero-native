{
  "name": "zero-native",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "compiler",
    "examples/*"
  ],
  "scripts": {
    "sample:js": "bun run examples/sample/build.ts",
    "dev": "bun run tools/zn-dev.ts",
    "ota": "bun run tools/ota/cli.ts",
    "ota:phone": "bun run tools/ota/phone-matrix.ts",
    "gen:registry": "bun run tools/gen-registry.ts",
    "test": "bun test packages compiler tools && bun run test:types",
    "test:types": "tsc -p packages/core/test/tsconfig.types.json && tsc -p examples/sample"
  },
  "devDependencies": {
    "fflate": "0.8.2",
    "hermes-compiler": "260318099.0.5",
    "typescript": "5.9.3"
  }
}
