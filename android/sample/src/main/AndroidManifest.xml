<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The sample loads a remote image (merchant avatar). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Vibration.vibrate (RN basics lab). As in React Native, the app declares it itself. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Analytics (plugins/analytics) with no ads: Play services' advertising id permissions out. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <!-- Scheduled notifications (plugins/push) come back after a reboot: the opt-in boot receiver below. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".SampleApp"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:label="zn sample"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Lets macrobenchmark and the Baseline Profile generator trace the release build (:baselineprofile). -->
        <profileable android:shell="true" />

        <!-- Notifications (plugins/push): the status bar icon for ours, and for those FCM shows by itself. -->
        <meta-data android:name="dev.zeronative.push.small_icon" android:resource="@drawable/ic_zn_notification" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_zn_notification" />
        <!-- Firebase Performance writes its traces to logcat too (tools/plugin-phone/perf.ts reads them). A dev app only. -->
        <meta-data android:name="firebase_performance_logcat_enabled" android:value="true" />
        <!-- Opt-in (plugins/push README): sets scheduled notifications again after a reboot or an app update. -->
        <receiver
            android:name="dev.zeronative.plugins.push.ZnNotificationBoot"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <!-- singleTop, not singleTask: singleTask would close another app opened for a result (a payment app) when the
                 user taps our icon. A link can then make a second MainActivity: see ZnNav.handleExtraActivity. -->
            <!-- adjustResize: the keyboard's height reaches the app as an inset; each route decides (keyboard option). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links zn://sample/<path>, matched against routes with deepLink: true (ARCHITECTURE §11). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zn" android:host="sample" />
            </intent-filter>
        </activity>
    </application>
</manifest>
