<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The sample loads a remote image (merchant avatar). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SampleApp"
        android:allowBackup="false"
        android:label="zn sample"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Lets macrobenchmark and the Baseline Profile generator trace the release build (:baselineprofile). -->
        <profileable android:shell="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <!-- singleTop, not singleTask: singleTask would close another app opened for a result (a payment app) when the
                 user taps our icon. A link can then make a second MainActivity: see ZnNav.handleExtraActivity. -->
            <!-- adjustResize: the keyboard's height reaches the app as an inset; each route decides (keyboard option). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links zn://sample/<path>, matched against routes with deepLink: true (ARCHITECTURE §11). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zn" android:host="sample" />
            </intent-filter>
        </activity>
    </application>
</manifest>
