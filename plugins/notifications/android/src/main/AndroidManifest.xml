<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+: showing a notification needs it, asked with Permissions.request(["notifications"]). Nothing asks by
         itself. No exact alarms, no boot receiver of its own (the app adds ZnNotificationBoot if it wants scheduled
         notifications back after a reboot: README), no foreground service. Pictures load over the runtime's INTERNET permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- A notification swiped away: runs the JS task "push.dismissed", and keeps the group summary right. -->
        <receiver
            android:name="dev.zeronative.plugins.notifications.ZnNotificationDismissed"
            android:exported="false" />

        <!-- A scheduled notification's alarm (Notifications.schedule): shows it natively. Never exported. The plugin
             asks for no exact-alarm permission; an app that wants exact times declares SCHEDULE_EXACT_ALARM itself. -->
        <receiver
            android:name="dev.zeronative.plugins.notifications.ZnNotificationTrigger"
            android:exported="false" />

        <!-- A notification's button with no link: runs the JS task "push.action" (Notifications.onAction). -->
        <receiver
            android:name="dev.zeronative.plugins.notifications.ZnNotificationAction"
            android:exported="false" />
    </application>
</manifest>
