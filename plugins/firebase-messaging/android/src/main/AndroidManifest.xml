<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- POST_NOTIFICATIONS and the notification receivers come from plugins/notifications. Firebase's own manifest adds
         INTERNET, WAKE_LOCK and the C2DM receive permission. -->
    <application>
        <!-- Every FCM message and new token. Data messages run the JS task "push.message". -->
        <service
            android:name="dev.zeronative.plugins.firebase.messaging.ZnMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
