{
  "name": "@zeronative/image-viewer",
  "version": "0.0.0",
  "description": "zero-native plugin: a full-screen photo viewer with zoom",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zero-native/zero-native.git",
    "directory": "plugins/image-viewer"
  },
  "homepage": "https://github.com/zero-native/zero-native/tree/main/plugins/image-viewer#readme",
  "type": "module",
  "main": "src/index.ts",
